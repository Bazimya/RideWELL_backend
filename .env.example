# RideWELL API configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=4000

# MongoDB must be a replica set (transactions). Locally:
#   mongod --replSet rs0 --port 27017 --dbpath <dir>   then in mongosh: rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/ridewell?replicaSet=rs0

# At least 32 characters each. Different values per environment.
JWT_ACCESS_SECRET=
HASH_PEPPER=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Browser origins allowed to call the API (comma-separated). https only in production.
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in admin invite links).
APP_BASE_URL=http://localhost:5173
# Reverse proxies in front of the API (Caddy in production = 1).
TRUST_PROXY_HOPS=0
# Defaults to true in production. Must be true in production.
# COOKIE_SECURE=true

# Notification adapters. `outbox` writes to OUTBOX_DIR instead of sending and is
# refused in production. Real providers (chosen 2026-11-25): Pindo for SMS, Resend for email.
SMS_PROVIDER=outbox
# With SMS_PROVIDER=pindo: token from the Pindo dashboard and your registered sender ID.
PINDO_API_TOKEN=
PINDO_SENDER_ID=RideWELL
EMAIL_PROVIDER=outbox
# With EMAIL_PROVIDER=resend: API key and a From address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
OUTBOX_DIR=var/outbox

JOBS_ENABLED=true
LOG_LEVEL=info

# Private document storage. `local` = AES-256-GCM encrypted files on disk (development
# only; refused in production). `s3` = any S3-compatible private bucket. TBD: provider.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/private-storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# TEMPORARY: email + password sign-up without email verification (no email provider
# yet). Must be false in production; the API refuses to start otherwise.
EMAIL_SIGNUP_WITHOUT_VERIFICATION=true

# ---------------------------------------------------------------------------
# DEVELOPMENT ACCOUNTS (npm run seed:dev-accounts). DEV ONLY: never in production.
# ---------------------------------------------------------------------------
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=
DEV_SUPER_ADMIN_PHONE=
DEV_SUPER_ADMIN_TOTP_SECRET=
DEV_OPS_ADMIN_EMAIL=
DEV_OPS_ADMIN_PASSWORD=
DEV_OPS_ADMIN_PHONE=
DEV_OPS_ADMIN_TOTP_SECRET=
DEV_CUSTOMER_EMAIL=
DEV_CUSTOMER_PASSWORD=
DEV_DRIVER_EMAIL=
DEV_DRIVER_PASSWORD=
DEV_OWNER_EMAIL=
DEV_OWNER_PASSWORD=

# DEV ONLY: a fixed 6-digit code accepted wherever a verification code is asked for (SMS codes,
# admin sign-in code, confirmations), so testing needs no SMS provider or authenticator app.
# Refused in production.
# DEV_VERIFICATION_CODE=123456
# DEV ONLY: raise the per-IP admin sign-in limit (default 20 per 15 min) for test runs. Refused in production.
# DEV_RATE_LIMIT_ADMIN_LOGIN=

# DEV ONLY: shared password for demo accounts created by `npm run seed:demo`.
DEV_DEMO_PASSWORD=

# Maps (Google Maps Platform, approved). dev = DEV ONLY: no place search, straight-line distance, no ETA; refused in production.
MAPS_PROVIDER=dev
# Server key: Places API (New), Routes API, Geocoding API. Never sent to the browser.
MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API only, restricted by HTTP referrer to RideWELL domains.
MAPS_BROWSER_KEY=
